# FixAtlas frontend environment (copy to .env). Values are PUBLIC (shipped to the browser).
# Never put the service_role key here; it belongs only in Supabase Edge Function secrets.

# Supabase project URL and anon (publishable) key: Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Optional: public site origin used for canonical URLs / sitemap (no trailing slash)
VITE_SITE_URL=https://fixatlas.example
